#!/usr/bin/env bash
# =============================================================================
# Edge Node Configuration
# =============================================================================
# REQUIRED — fill in the EDGE_NODES array below with one line per edge site.
#
# Each line is pipe-separated:
#   CLUSTER_NAME|NODE_IP|SSH_USER|SSH_KEY|PROJECT_ID|S3_ACCESS_KEY|S3_SECRET_KEY
#
# Fields:
#   CLUSTER_NAME    - Unique name for this edge cluster (e.g. edge-uqcai)
#   NODE_IP         - Public IP of the edge worker VM
#   SSH_USER        - SSH user on the edge VM (usually ubuntu)
#   SSH_KEY         - Path to SSH private key for this node
#   PROJECT_ID      - Default XNAT project ID for ingested data from this site
#   S3_ACCESS_KEY   - SeaweedFS access key for this edge (scoped: write+list on bucket)
#   S3_SECRET_KEY   - SeaweedFS secret key for this edge
#
# Each edge node gets:
#   - Its own k0smotron hosted cluster (separate control plane)
#   - Its own scoped S3 credentials (write to ingest-bucket only — isolated per site)
#   - Its own xnat-ingest sort + s3-uploader pods
#   - Optionally its own Orthanc pod, unless EDGE_ORTHANC_MODE=external
#
# Example with multiple sites:
# EDGE_NODES=(
#   "edge-uqcai|203.101.230.171|ubuntu|~/.ssh/id_ed25519|uqcai-project|uqcai-edge-key|uqcai-secret-change-me"
#   "edge-usyd|10.0.1.50|ubuntu|~/.ssh/id_ed25519|usyd-project|usyd-edge-key|usyd-secret-change-me"
#   "edge-newcastle|10.0.2.50|ubuntu|~/.ssh/id_ed25519|newcastle-project|newcastle-edge-key|newcastle-secret-change-me"
# )
# =============================================================================

# REQUIRED — replace this placeholder with your actual edge node(s):
EDGE_NODES=(
  "edge-REPLACE_ME|REPLACE_WITH_EDGE_IP|ubuntu|~/.ssh/id_ed25519|REPLACE_WITH_PROJECT_ID|REPLACE_WITH_S3_KEY|REPLACE_WITH_S3_SECRET"
)

# --- Shared Edge Settings ---
export INGEST_LOOP_SECONDS="60"               # How often sort/upload checks for new data
export INGEST_WAIT_PERIOD="60"                # Seconds to wait for stable sessions before staging
export S3_UPLOAD_MAX_WORKERS="2"              # mc mirror workers per edge upload
export S3_UPLOAD_LIMIT_UPLOAD="80MiB"         # mc upload throttle for management S3
export EDGE_K0S_DATA_DIR="/data/k0s"          # Keep worker container/kubelet state off small root disks

# --- Edge bootstrap mode ---
# ssh    — management node can SSH into the edge and runs scripts/06 directly.
# manual — management creates a bootstrap bundle under secrets/; a site admin
#          runs it locally on the edge. Use this for machines behind firewalls.
export EDGE_JOIN_MODE="ssh"                    # ssh | manual

# When EDGE_JOIN_MODE=manual, later deploy steps must not try to create
# directories or run curl smoke tests over SSH.
export AIS_EDGE_NO_SSH=""                      # set to "1" for manual/unreachable edges

# --- Orthanc mode ---
# managed  — this repo deploys Orthanc on the edge in step 07c.
# external — Orthanc already exists on the edge. Step 07c is skipped and
#            xnat-ingest sort points at EDGE_ORTHANC_URL instead.
export EDGE_ORTHANC_MODE="managed"             # managed | external

# Existing-Orthanc settings. These are also valid for managed mode, but the
# defaults match the repo-managed Orthanc Service and storage layout.
export EDGE_ORTHANC_URL="http://orthanc.xnat-ingest.svc.cluster.local:8042"
export EDGE_DATA_HOST_PATH="/data/xnat-ingest"
export EDGE_ORTHANC_STORAGE_HOST_PATH="/data/xnat-ingest/orthanc-storage"
export EDGE_ORTHANC_STORAGE_DIR="/data/orthanc-storage"

# Label contract expected by the AIS Orthanc Lua hook. If an external Orthanc
# does not apply these labels, update its Lua hook/config first, or set these
# only after confirming xnat-ingest supports unlabeled Orthanc polling.
export EDGE_ORTHANC_LABEL="xnat-ingest-ready"
export EDGE_ORTHANC_SKIP_LABEL="xnat-ingest-skip"
